# ========================================================
# Wixfox Minecraft Network - Production Environment Template
# Compliant with PRD v1.0 & Security Audit Recommendations
# Run './infrastructure/security/generate-secrets.sh' to generate high-entropy secrets!
# ========================================================

# Environment Mode: development | production | test
NODE_ENV=production

# --------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION (Finding 6: Role Separation)
# --------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wixfox_network

# Administrative Superuser (Restricted to DDL & initial setup)
POSTGRES_USER=wixfox_admin
POSTGRES_PASSWORD=generate_via_infrastructure_security_generate_secrets_sh

# Application DML User (Used by NestJS API and Paper plugins)
POSTGRES_APP_USER=wixfox_app

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Database Pool Settings (HikariCP / pg-pool)
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# --------------------------------------------------------
# 2. MINECRAFT SERVER CONFIGURATION (Finding 9: Build Pinning)
# --------------------------------------------------------
# Public Game Ports (TCP 25565 / UDP 19132)
JAVA_PORT=25565
BEDROCK_PORT=19132

# Java Runtime / Memory Allocation (Aikar's Flags)
MINECRAFT_RAM_MIN=4G
MINECRAFT_RAM_MAX=5G

# Paper Pinned Version (Finding 9)
MINECRAFT_VERSION=1.20.4
PAPER_BUILD=499
SERVER_NAME=wixfox-smp
SERVER_MOTD=§b§lWIXFOX NETWORK §7• §fSurvival SMP §8[§aJava + Bedrock§8]

# RCON Administration (Strictly internal network only)
RCON_ENABLED=true
RCON_PORT=25575
RCON_PASSWORD=generate_via_infrastructure_security_generate_secrets_sh

# --------------------------------------------------------
# 3. BACKEND API CONFIGURATION (Finding 7: Short-Lived JWT)
# --------------------------------------------------------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# JWT Authentication (15-minute access token, 7-day refresh token)
JWT_SECRET=generate_via_infrastructure_security_generate_secrets_sh
JWT_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=604800s

# Allowed CORS Origins (Finding 8: Strict production separation)
# Production: exact domain only. Development: localhost
CORS_ORIGIN=https://admin.wixfox.net,http://127.0.0.1:8080

# --------------------------------------------------------
# 4. ADMIN DASHBOARD (React + Nginx) (Finding 3: Loopback Bound)
# --------------------------------------------------------
ADMIN_PORT=8080
VITE_API_URL=/api

# --------------------------------------------------------
# 5. ENCRYPTED BACKUP & DISASTER RECOVERY (Finding 10: AES-256)
# --------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=3

# GPG Symmetric AES-256 Encryption Key
BACKUP_ENCRYPTION_KEY=generate_via_infrastructure_security_generate_secrets_sh
