# ========================================================
# Wixfox Minecraft Network - Environment Configuration
# ========================================================

# Environment Mode: development | production | test
NODE_ENV=production

# --------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# --------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wixfox_network
POSTGRES_USER=wixfox_admin
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password_min_32_chars
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Database Pool Settings (used by NetworkCore & NestJS API)
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# --------------------------------------------------------
# 2. MINECRAFT SERVER CONFIGURATION
# --------------------------------------------------------
# Minecraft Ports
JAVA_PORT=25565
BEDROCK_PORT=19132

# Java Runtime / Memory Allocation (Aikar's Flags)
# 4GB to 5GB allocated to Paper for 20 concurrent players
MINECRAFT_RAM_MIN=4G
MINECRAFT_RAM_MAX=5G

# Paper Configuration
MINECRAFT_VERSION=1.20.4
PAPER_BUILD=latest
SERVER_NAME=wixfox-smp
SERVER_MOTD=§b§lWIXFOX NETWORK §7• §fSurvival SMP §8[§aJava + Bedrock§8]

# RCON Administration (Restricted to internal network)
RCON_ENABLED=true
RCON_PORT=25575
RCON_PASSWORD=replace_with_a_very_secure_rcon_password

# --------------------------------------------------------
# 3. BACKEND API (NestJS) CONFIGURATION
# --------------------------------------------------------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_64_characters
JWT_EXPIRATION=86400s
ADMIN_API_KEY=replace_with_internal_admin_api_token

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:8080,https://admin.wixfox.net

# --------------------------------------------------------
# 4. ADMIN DASHBOARD (React + Nginx)
# --------------------------------------------------------
ADMIN_PORT=8080
VITE_API_URL=/api

# --------------------------------------------------------
# 5. BACKUP & RETENTION
# --------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=3

# Remote Backup Target (Optional Offsite Storage)
# S3_ENDPOINT=https://s3.region.amazonaws.com
# S3_BUCKET=wixfox-backups
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
